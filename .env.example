# Telegram Bot Token - REQUIRED
# Get it from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Admin IDs - Optional, comma-separated list
# IDs of Telegram users who should have admin access
ADMIN_IDS=123456789,987654321

# Database Configuration
DATABASE_NAME=milohvost.db

# Logging Level
LOGGING_LEVEL=INFO

# Order Display Configuration
ORDERS_PER_PAGE=10
MAX_PREVIEW_TEXT_LENGTH=30
USER_ORDERS_PER_PAGE=5

# Web Form Configuration (for future FastAPI integration)
WEB_FORM_USER_ID=-1
WEB_HOST=127.0.0.1
WEB_PORT=8080

